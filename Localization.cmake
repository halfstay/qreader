# Embed UTF-8 catalogs; no translation framework or build-time Python required.
set(QREADER_LOCALE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/res/i18n")
configure_file("${QREADER_LOCALE_DIR}/languages.txt" "${CMAKE_CURRENT_BINARY_DIR}/languages.txt" COPYONLY)
file(STRINGS "${QREADER_LOCALE_DIR}/languages.txt" QREADER_LANGUAGES ENCODING UTF-8)
set(QREADER_LOCALE_RC "${CMAKE_CURRENT_BINARY_DIR}/locales.rc")
set(locale_resources "#include <windows.h>\nLANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL\n5000 RCDATA \"${QREADER_LOCALE_DIR}/languages.txt\"\n")
set(resource_id 5001)
set(locale_dependencies "${QREADER_LOCALE_DIR}/languages.txt")
foreach(language ${QREADER_LANGUAGES})
    if(NOT language MATCHES "^#" AND NOT language STREQUAL "")
        string(REGEX REPLACE "\\|.*" "" tag "${language}")
        string(APPEND locale_resources "${resource_id} RCDATA \"${QREADER_LOCALE_DIR}/${tag}.lang\"\n")
        list(APPEND locale_dependencies "${QREADER_LOCALE_DIR}/${tag}.lang")
        math(EXPR resource_id "${resource_id} + 1")
    endif()
endforeach()
file(WRITE "${QREADER_LOCALE_RC}" "${locale_resources}")
set_source_files_properties("${QREADER_LOCALE_RC}" PROPERTIES OBJECT_DEPENDS "${locale_dependencies}")
